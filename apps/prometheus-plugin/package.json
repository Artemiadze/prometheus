{
  "name": "prometheus-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian Community Plugin for the local Prometheus RAG runtime",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,md,css}\" \"scripts/**/*.mjs\" && node scripts/check-manifest-version.mjs",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix && prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md,css}\" \"scripts/**/*.mjs\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && node scripts/check-prod-bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "esbuild": "^0.25.1",
    "eslint": "^8.57.1",
    "obsidian": "^1.8.7",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
